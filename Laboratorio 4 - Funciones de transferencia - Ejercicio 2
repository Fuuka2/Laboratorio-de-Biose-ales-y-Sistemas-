import numpy as np

# Coeficientes del primer polinomio
P1 = [1, 0, -3, -2, 4, 4, 1, 10]

# Coeficientes del segundo polinomio
P2 = [1, 0, -5, 0, 3, -4, 7, -1, -19]

# Calcular raíces
raices_P1 = np.roots(P1)
raices_P2 = np.roots(P2)

# Mostrar resultados
print("RAÍCES DEL POLINOMIO P1")
for i, raiz in enumerate(raices_P1, start=1):
    print(f"s{i} = {raiz.real:.6f} {raiz.imag:+.6f}j")

print("\nRAÍCES DEL POLINOMIO P2")
for i, raiz in enumerate(raices_P2, start=1):
    print(f"s{i} = {raiz.real:.6f} {raiz.imag:+.6f}j")
