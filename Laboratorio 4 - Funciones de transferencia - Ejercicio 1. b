import numpy as np
import matplotlib.pyplot as plt

def x(t):
    return np.cos(4*np.pi*t)

periodos = [1, 1/2, 1/8]
n = np.arange(-20, 21)
fig, axes = plt.subplots(3, 1, figsize=(11, 10))
for ax, T in zip(axes, periodos):
    tn = n*T
    t = np.linspace(tn.min(), tn.max(), max(3000, int(800*(tn.max()-tn.min()))))
    ax.plot(t, x(t), color='tab:blue', label='Señal continua')
    ax.stem(tn, x(tn), linefmt='C1-', markerfmt='C1o', basefmt='k-')
    ax.set(title=f'x2(t) = cos(4*pi*t), T = {T:g} s', xlabel='Tiempo (s)', ylabel='Peso del impulso / amplitud', ylim=(-1.2,1.2))
    ax.grid(alpha=.3)
    ax.legend()
fig.tight_layout()
fig.savefig('muestreo_x2.png', dpi=200)
plt.show()

import numpy as np
import matplotlib.pyplot as plt

def x(t):
    return np.where(t >= 0, np.exp(-np.maximum(t, 0))*np.cos(4*np.pi*t), 0.0)

periodos = [1, 1/2, 1/8]
n = np.arange(-20, 21)
fig, axes = plt.subplots(3, 1, figsize=(11, 10))
for ax, T in zip(axes, periodos):
    tn = n*T
    t = np.linspace(tn.min(), tn.max(), max(3000, int(800*(tn.max()-tn.min()))))
    ax.plot(t, x(t), color='tab:blue', label='Señal continua')
    ax.stem(tn, x(tn), linefmt='C1-', markerfmt='C1o', basefmt='k-')
    ax.set(title=f'x3(t) = exp(-t)*cos(4*pi*t)*u(t), T = {T:g} s', xlabel='Tiempo (s)', ylabel='Peso del impulso / amplitud', ylim=(-1.2,1.2))
    ax.grid(alpha=.3)
    ax.legend()
fig.tight_layout()
fig.savefig('muestreo_x3.png', dpi=200)
plt.show()
