import sympy as sp
from scipy.signal import zpk2tf

# Variable simbólica
s = sp.symbols('s')

# Nombre, ceros, polos y ganancia
funciones = [
    ("1", [-3], [-1+5j, -1-5j], 7),
    ("2", [5, -3], [2+3j, 2-3j, 2], 1),
    ("3", [7, -1], [2, 3, 7], 1)
]

for nombre, ceros, polos, k in funciones:

    # Obtener coeficientes
    num, den = zpk2tf(ceros, polos, k)

    # Convertir coeficientes a enteros
    num = [int(round(x.real)) for x in num]
    den = [int(round(x.real)) for x in den]

    # Construir polinomios
    N = sp.Poly(num, s).as_expr()
    D = sp.Poly(den, s).as_expr()

    # Simplificar función de transferencia
    G = sp.cancel(N / D)

    # Generar y mostrar únicamente código LaTeX
    print(f"G_{nombre}(s) = {sp.latex(G)}")
