import numpy as np
import matplotlib.pyplot as plt

# Señal x1(t) = cos(pi*t/2)
def x1(t):
    return np.cos(np.pi * t / 2)

# Periodos de muestreo
periodos = [1, 1/2, 1/8]
n = np.arange(-20, 21)

fig, axes = plt.subplots(3, 1, figsize=(11, 10))

for ax, T in zip(axes, periodos):
    # Instantes de muestreo
    tn = n * T

    # Valores muestreados
    xn = x1(tn)

    # Señal continua
    t = np.linspace(tn[0], tn[-1], 2000)

    ax.plot(t, x1(t), 'b-', linewidth=1.8,
            label='Señal continua x₁(t)')

    # Representación de impulsos
    markerline, stemlines, baseline = ax.stem(
        tn, xn, linefmt='r-', markerfmt='ro', basefmt='k-'
    )

    plt.setp(stemlines, linewidth=1.2)
    plt.setp(markerline, markersize=4)

    ax.set_title(
        rf'$x_1(t)=\cos(\pi t/2)$  |  $T={T:g}\ s$'
    )
    ax.set_xlabel('Tiempo (s)')
    ax.set_ylabel('Amplitud')
    ax.set_ylim(-1.2, 1.2)
    ax.grid(True, alpha=0.3)
    ax.legend(['Señal continua', 'Muestras'])

plt.tight_layout()
plt.savefig('muestreo_x1.png', dpi=300)
plt.show()
