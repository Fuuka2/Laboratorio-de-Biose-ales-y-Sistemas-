import numpy as np
import sympy as sp
from scipy.signal import residue

s = sp.Symbol('s')

# Numeradores y denominadores
funciones = [
    ("G1", [16, 0, 16], [1, 6, 8]),
    ("G2", [1, 1, 3], [1, 4, 2, 2]),
    ("G3", [1, 2], [1, 3]),
    ("G4", [1, 0], [1, -2, -3]),
    ("G5", [2, 4, 8], [1, 0, 8, 0, 16]),
    ("G6", [6, 0, 1], [1, 3, 0, 1]),
    ("G7", [1, 2, 1], [1, 2, 1, 0])
]

# Redondear números reales y complejos
def redondear(z):
    real = round(float(np.real(z)), 3)
    imag = round(float(np.imag(z)), 3)

    if abs(real) < 0.0005:
        real = 0

    if abs(imag) < 0.0005:
        imag = 0

    return sp.Float(real, 3) + sp.Float(imag, 3)*sp.I

# Obtener fracciones parciales
for nombre, num, den in funciones:

    r, p, k = residue(num, den)

    terminos = []

    # Parte polinómica directa
    if len(k) > 0:
        polinomio = sum(
            redondear(coef)*s**(len(k)-i-1)
            for i, coef in enumerate(k)
        )
        terminos.append(sp.latex(polinomio))

    # Residuos y polos
    for i, (residuo, polo) in enumerate(zip(r, p)):

        potencia = 1 + sum(
            np.isclose(p[:i], polo, atol=1e-5)
        )

        R = redondear(residuo)
        P = redondear(polo)

        if R == 0:
            continue

        termino = sp.Mul(
            R,
            sp.Pow(s - P, -int(potencia), evaluate=False),
            evaluate=False
        )

        terminos.append(sp.latex(termino))

    # Mostrar únicamente LaTeX
    expresion_latex = " + ".join(terminos)
    print(f"{nombre}(s) = {expresion_latex}\n")
